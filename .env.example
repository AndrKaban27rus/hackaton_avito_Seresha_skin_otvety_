# Copy to .env and fill in locally. .env is ignored by git.
# Empty LLM_API_KEY = deterministic demo mode without a model.
LLM_API_KEY=
# One model or a comma-separated fallback list; each must support tools and tool_choice.
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free,inclusionai/ling-3.2-flash:free
LLM_BASE_URL=https://openrouter.ai/api/v1

# Local run without Docker (go run ./cmd/api):
# empty DATABASE_URL starts a local PostgreSQL in the user cache folder.
DATABASE_URL=
HOST=127.0.0.1
PORT=8080
